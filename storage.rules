rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Deny all by default
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User-specific resumes and profile uploads
    match /users/{userId}/resumes/{allPaths=**} {
      allow read, write: if isOwner(userId)
                          && request.resource.size < 10 * 1024 * 1024; // 10MB max
    }

    // User-specific project screenshots and demo images
    match /users/{userId}/projects/{allPaths=**} {
      allow read: if true; // Public project images viewable
      allow write: if isOwner(userId)
                          && request.resource.size < 5 * 1024 * 1024 // 5MB max
                          && request.resource.contentType.matches('image/.*');
    }

    // User-specific interview audio/video recordings (Canonical structure)
    match /interviewVideos/{userId}/{sessionId}/{allPaths=**} {
      allow read, write: if isOwner(userId)
                          && request.resource.size < 150 * 1024 * 1024; // 150MB max
    }

    // Legacy fallback path
    match /users/{userId}/interviews/{allPaths=**} {
      allow read, write: if isOwner(userId)
                          && request.resource.size < 150 * 1024 * 1024;
    }
  }
}
