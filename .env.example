# ==============================================================================
# Edworld Co — Environment Configuration (.env.local)
# ==============================================================================

# Next.js Public Firebase Client SDK Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyFakeKeyForLocalDev123456789
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=edworld-co-prod.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=edworld-co-prod
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=edworld-co-prod.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456789

# Optional: Firebase Emulator Suite Connection
# Set to "true" when running against local Firebase Emulators (auth:9099, firestore:8080, functions:5001, storage:9199)
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false

