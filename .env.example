# ==============================================================================
# EdWorld Co — Environment Configuration (.env.local)
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=https://edworldco.in

# ------------------------------------------------------------------------------
# Supabase Database & Auth Client Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# AI & LLM Engine Configuration (Google Gemini / Universal AI)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-1.5-flash

# Optional: OpenRouter / OpenAI Fallback
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ------------------------------------------------------------------------------
# Razorpay Payments Configuration (INR / UPI / Cards)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ------------------------------------------------------------------------------
# Resend Transactional Email Provider
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=EdWorld Co <notifications@edworldco.in>

# ------------------------------------------------------------------------------
# Internal Security & Cron Auth
# ------------------------------------------------------------------------------
CRON_SECRET=your_internal_cron_secret
