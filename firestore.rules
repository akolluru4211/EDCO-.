rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isMinor(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) &&
             get(/databases/$(database)/documents/users/$(userId)).data.ageBand != '18+';
    }

    // Users collection
    match /users/{userId} {
      // Owner can read and write their user root doc
      // dob is only stored on user doc for ageBand derivation
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
                    && (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false)
                    && (!('isEmployer' in request.resource.data) || request.resource.data.isEmployer == false);
      allow update: if isOwner(userId)
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'isEmployer']));

      // Subcollection: Profile
      match /profile/{docId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId)
                     && (!isMinor(userId) || (
                          request.resource.data.isPublic == false &&
                          request.resource.data.isMentor == false &&
                          (!('mentorTags' in request.resource.data) || request.resource.data.mentorTags.size() == 0)
                        ));
      }

      // Subcollection: Rate limits
      match /rateLimits/{limitId} {
        allow read, write: if isOwner(userId);
      }

      // Subcollection: Notifications
      match /notifications/{notifId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Consents collection (TOS, Privacy, Guardian Consent for Minors)
    match /consents/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Guardian Consents collection (publicly accessible by secure token)
    match /guardianConsents/{tokenId} {
      allow read, write: if true;
    }

    // Audit logs
    match /auditLogs/{logId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && request.auth.token.isAdmin == true;
    }

    // Projects collection
    match /projects/{projectId} {
      // Public projects are viewable by anyone; private projects only by owner
      allow read: if resource.data.isPublic == true ||
                     (isAuthenticated() && resource.data.userId == request.auth.uid) ||
                     (isAuthenticated() && request.auth.token.isAdmin == true);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Resumes collection
    match /resumes/{resumeId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;

      match /analyses/{analysisId} {
        allow read, write: if isAuthenticated() && get(/databases/$(database)/documents/resumes/$(resumeId)).data.userId == request.auth.uid;
      }
    }

    // Interview Questions collection (read by authenticated users, written by admin only)
    match /interviewQuestions/{questionId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.token.isAdmin == true;
    }

    // Interview Sessions collection (private to the user)
    match /interviewSessions/{sessionId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Job Listings collection (18+ only)
    match /jobs/{jobId} {
      allow read: if isAuthenticated() && !isMinor(request.auth.uid) && (
                    (resource.data.isActive == true && resource.data.moderationStatus == 'approved') ||
                    resource.data.postedBy == request.auth.uid ||
                    request.auth.token.isAdmin == true
                  );
      allow create: if isAuthenticated() && !isMinor(request.auth.uid) && (
                      request.resource.data.postedBy == request.auth.uid ||
                      request.auth.token.isAdmin == true
                    );
      allow update, delete: if isAuthenticated() && !isMinor(request.auth.uid) && (
                              resource.data.postedBy == request.auth.uid ||
                              request.auth.token.isAdmin == true
                            );
    }

    // Job Applications collection (18+ only, isolated between applicant & employer)
    match /applications/{applicationId} {
      allow create: if isAuthenticated() && !isMinor(request.auth.uid) && request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated() && !isMinor(request.auth.uid) && (
                    resource.data.userId == request.auth.uid ||
                    request.auth.uid == get(/databases/$(database)/documents/jobs/$(resource.data.jobId)).data.postedBy ||
                    request.auth.token.isAdmin == true
                  );
      allow update: if isAuthenticated() && !isMinor(request.auth.uid) && (
                      request.auth.uid == get(/databases/$(database)/documents/jobs/$(resource.data.jobId)).data.postedBy ||
                      request.auth.token.isAdmin == true
                    );
      allow delete: if isAuthenticated() && !isMinor(request.auth.uid) && (
                      resource.data.userId == request.auth.uid ||
                      request.auth.token.isAdmin == true
                    );
    }

    // Usernames collection (Unique lookup for /u/[username])
    match /usernames/{username} {
      allow read: if resource.data.isPublic == true && resource.data.ageBand == '18+';
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid && !isMinor(request.auth.uid);
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || request.auth.token.isAdmin == true);
    }

    // Connections collection
    match /connections/{connectionId} {
      allow read: if isAuthenticated() && (
                    resource.data.requesterId == request.auth.uid ||
                    resource.data.recipientId == request.auth.uid ||
                    request.auth.token.isAdmin == true
                  );
      allow create: if isAuthenticated() && request.resource.data.requesterId == request.auth.uid && !isMinor(request.auth.uid);
      allow update: if isAuthenticated() && (
                      resource.data.recipientId == request.auth.uid ||
                      resource.data.requesterId == request.auth.uid ||
                      request.auth.token.isAdmin == true
                    );
      allow delete: if isAuthenticated() && (
                      resource.data.requesterId == request.auth.uid ||
                      resource.data.recipientId == request.auth.uid ||
                      request.auth.token.isAdmin == true
                    );
    }

    // Conversations collection (1:1 messaging for connected 18+ users)
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && (
                    request.auth.uid in resource.data.participantIds &&
                    !isMinor(request.auth.uid)
                  );
      allow create: if isAuthenticated() && (
                      request.auth.uid in request.resource.data.participantIds &&
                      !isMinor(request.auth.uid)
                    );
      allow update: if isAuthenticated() && (
                      request.auth.uid in resource.data.participantIds &&
                      !isMinor(request.auth.uid)
                    );

      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
                      request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds &&
                      !isMinor(request.auth.uid)
                    );
        allow create: if isAuthenticated() && (
                        request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds &&
                        request.resource.data.senderId == request.auth.uid &&
                        !isMinor(request.auth.uid)
                      );
      }
    }

    // User Blocks collection
    match /blocks/{blockId} {
      allow read: if isAuthenticated() && (resource.data.blockerId == request.auth.uid || request.auth.token.isAdmin == true);
      allow create: if isAuthenticated() && request.resource.data.blockerId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.blockerId == request.auth.uid;
    }

    // Mentors collection
    match /mentors/{mentorId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid && !isMinor(request.auth.uid);
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || request.auth.token.isAdmin == true);
    }

    // Mentorship Requests collection
    match /mentorshipRequests/{requestId} {
      allow read: if isAuthenticated() && (
                    resource.data.senderId == request.auth.uid ||
                    resource.data.receiverId == request.auth.uid ||
                    request.auth.token.isAdmin == true
                  );
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      allow update: if isAuthenticated() && (
                      resource.data.receiverId == request.auth.uid ||
                      resource.data.senderId == request.auth.uid ||
                      request.auth.token.isAdmin == true
                    );
    }

    // Message Threads collection
    match /messageThreads/{threadId} {
      allow read: if isAuthenticated() && (
                    request.auth.uid in resource.data.participants ||
                    request.auth.token.isAdmin == true
                  );
      allow create: if isAuthenticated() && (request.auth.uid in request.resource.data.participants);
      allow update: if isAuthenticated() && (request.auth.uid in resource.data.participants);

      match /messages/{messageId} {
        allow read, write: if isAuthenticated() && (request.auth.uid in get(/databases/$(database)/documents/messageThreads/$(threadId)).data.participants);
      }
    }

    // Peer Study Circles collection
    match /peerStudyCircles/{circleId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated() && request.auth.token.isAdmin == true;
    }

    // Subscriptions collection (read by owner, managed by admin/cloud functions)
    match /subscriptions/{userId} {
      allow read: if isOwner(userId) || (isAuthenticated() && request.auth.token.isAdmin == true);
      allow write: if isAuthenticated() && request.auth.token.isAdmin == true;
    }

    // Content Reports collection (created by authenticated users, reviewed by admin)
    match /reports/{reportId} {
      allow create: if isAuthenticated() && request.resource.data.reportedBy == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && request.auth.token.isAdmin == true;
    }

    // Audit Logs collection (Read-only by platform admins, zero client-side write access)
    match /auditLogs/{logId} {
      allow read: if isAuthenticated() && request.auth.token.isAdmin == true;
      allow write: if false; // Server-side Cloud Functions only
    }
  }
}
